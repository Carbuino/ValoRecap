{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Discord Bot",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "."
      ]
    },
    {
      "name": "Deploy Commands",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "deploy.js"
      ]
    },
    {
      "name": "Debug Crosshair HTML",
      "type": "firefox",
      "request": "launch",
      "url": "http://127.0.0.1:3000/js/crosshair/generator.html",
      "pathMappings": [
        {
          "url": "http://127.0.0.1:3000/js",
          "path": "${workspaceFolder}/js"
        }
      ]
    }
  ]

}